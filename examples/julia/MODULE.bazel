"""Example running Jupyter notebooks with a Julia kernel.

The kernel is an ordinary Bazel target described with `jupyter_kernelspec`:
`IJulia` from `rules_julia`, started by a `julia_binary`. Julia itself and
every package are fetched and built by Bazel; nothing is read from `~/.julia`.

This example is designed to be built from within the examples/julia directory.
It uses local_path_override to reference the parent rules_jupyter module.
"""

module(
    name = "jupyter_julia_example",
    version = "0.0.0",
)

bazel_dep(name = "rules_jupyter", version = "0.0.0")
bazel_dep(name = "rules_req_compile", version = "1.3.0")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_julia", version = "0.8.0")

# Override to use local path to parent rules_jupyter module
local_path_override(
    module_name = "rules_jupyter",
    path = "../..",
)

# Pandoc is used by the markdown exporter.
jupyter = use_extension("@rules_jupyter//jupyter:extensions.bzl", "jupyter")
jupyter.pandoc(
    name = "pandoc",
)
use_repo(
    jupyter,
    "pandoc",
)

# Python dependencies of the Jupyter toolchain (`jupyter`, `jupytext`, `nbconvert`).
requirements = use_extension("@rules_req_compile//extensions:python.bzl", "requirements")
requirements.parse(
    name = "pip_deps",
    config_settings = {
        "//requirements:linux_aarch64": "linux_aarch64",
        "//requirements:linux_x86_64": "linux_x86_64",
        "//requirements:macos_aarch64": "macos_aarch64",
        "//requirements:windows_x86_64": "windows_x86_64",
    },
    requirements_locks = {
        "//requirements:requirements_linux_aarch64.txt": "linux_aarch64",
        "//requirements:requirements_linux_x86_64.txt": "linux_x86_64",
        "//requirements:requirements_macos_aarch64.txt": "macos_aarch64",
        "//requirements:requirements_windows_x86_64.txt": "windows_x86_64",
    },
)
use_repo(requirements, "pip_deps")

julia = use_extension("@rules_julia//julia:extensions.bzl", "julia")
use_repo(julia, "julia_toolchains")

# Julia packages of the kernel (`IJulia`), resolved by `//kernel:pkg_update`.
julia_pkg = use_extension("@rules_julia//julia/pkg:extensions.bzl", "pkg")
julia_pkg.from_manifest(
    name = "julia_deps",
    manifest = "//kernel:Manifest.toml",
)

# `IJulia` and its dependency `Conda` each expect constants that their
# `Pkg.build` step writes to `deps/deps.jl`. rules_julia does not run build
# scripts, so the constants are patched into the modules instead.
julia_pkg.pkg_annotation(
    dep = "Conda",
    patch_args = ["-p1"],
    patches = ["//kernel:conda_deps.patch"],
)
julia_pkg.pkg_annotation(
    dep = "IJulia",
    patch_args = ["-p1"],
    patches = ["//kernel:ijulia_deps.patch"],
)
use_repo(julia_pkg, "julia_deps")

register_toolchains(
    "//:jupyter_toolchain",
    "@julia_toolchains//:all",
)
