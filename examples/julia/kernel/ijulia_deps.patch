IJulia refuses to load until `Pkg.build("IJulia")` has written `deps/deps.jl`.
rules_julia never runs package build scripts, so the two constants that file
defines are provided in the module instead.

diff -ruN a/src/IJulia.jl b/src/IJulia.jl
--- a/src/IJulia.jl	2026-10-14 16:19:51.154178926 -0700
+++ b/src/IJulia.jl	2026-10-14 16:19:51.228420074 -0700
@@ -49,8 +49,16 @@
 import InteractiveUtils
 
 const depfile = joinpath(dirname(@__FILE__), "..", "deps", "deps.jl")
-isfile(depfile) || error("IJulia not properly installed. Please run Pkg.build(\"IJulia\")")
-include(depfile) # generated by Pkg.build("IJulia")
+if isfile(depfile)
+    include(depfile) # generated by Pkg.build("IJulia")
+else
+    # `Pkg.build("IJulia")` writes `deps/deps.jl` in a regular installation.
+    # Bazel does not run build scripts, so the constants are defined here
+    # instead. `JUPYTER` only matters to `IJulia.notebook()` and friends, which
+    # the kernel never calls; rules_jupyter supplies Jupyter itself.
+    const IJULIA_DEBUG = false
+    const JUPYTER = "jupyter"
+end
 
 # use our own random seed for msg_id so that we
 # don't alter the user-visible random state (issue #336)
