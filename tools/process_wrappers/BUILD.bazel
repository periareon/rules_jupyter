# Note that this package exists outside of `//jupyter` to avoid conflicting
# with the existing `jupyter` import path.

load("@rules_venv//python:py_binary.bzl", "py_binary")
load("@rules_venv//python:py_library.bzl", "py_library")
load("@rules_venv//python/pytest:defs.bzl", "py_pytest_test")

exports_files([
    "autorun.js",
    "autorun_transform.py",
    "compiler.py",
    "ibazel_handler.py",
    "ibazel_reload.js",
    "lab_launcher.py",
    "reporter.py",
    "runner.py",
    "tester.py",
])

py_binary(
    name = "compiler",
    srcs = ["compiler.py"],
    visibility = ["//visibility:public"],
    deps = ["//jupyter:current_jupytext_toolchain"],
)

# The runtime shared by every wrapper: environment setup, kernelspecs,
# notebook execution and report export.
py_library(
    name = "notebook_env",
    srcs = [
        "exporters.py",
        "kernels.py",
        "notebook_env.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//jupyter:current_jupyter_toolchain",
        "@rules_venv//python/runfiles",
    ],
)

py_binary(
    name = "reporter",
    srcs = ["reporter.py"],
    visibility = ["//visibility:public"],
    deps = [":notebook_env"],
)

py_binary(
    name = "tester",
    srcs = ["tester.py"],
    visibility = ["//visibility:public"],
    deps = [":notebook_env"],
)

py_binary(
    name = "runner",
    srcs = ["runner.py"],
    visibility = ["//visibility:public"],
    deps = [":notebook_env"],
)

py_binary(
    name = "lab_launcher",
    srcs = ["lab_launcher.py"],
    data = [
        "autorun.js",
        "autorun_transform.py",
        "ibazel_reload.js",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":ibazel_handler",
        ":notebook_env",
    ],
)

py_pytest_test(
    name = "notebook_env_test",
    srcs = ["notebook_env_test.py"],
    deps = [":notebook_env"],
)

py_library(
    name = "ibazel_handler",
    srcs = ["ibazel_handler.py"],
    visibility = ["//visibility:public"],
    deps = ["//jupyter:current_jupyter_toolchain"],
)
