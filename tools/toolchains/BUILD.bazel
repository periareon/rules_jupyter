load("@rules_venv//python:py_library.bzl", "py_library")
load("@rules_venv//python/black:defs.bzl", "py_black_toolchain")
load("@rules_venv//python/isort:defs.bzl", "py_isort_toolchain")
load("@rules_venv//python/mypy:defs.bzl", "py_mypy_toolchain")
load("@rules_venv//python/pylint:defs.bzl", "py_pylint_toolchain")
load("@rules_venv//python/pytest:defs.bzl", "py_pytest_toolchain")
load("//jupyter:jupyter_toolchain.bzl", "jupyter_toolchain")

package(default_visibility = ["//visibility:public"])

py_black_toolchain(
    name = "py_black_toolchain",
    black = "@pip_jupyter//black",
)

toolchain(
    name = "black_toolchain",
    toolchain = ":py_black_toolchain",
    toolchain_type = "@rules_venv//python/black:toolchain_type",
)

py_isort_toolchain(
    name = "py_isort_toolchain",
    isort = "@pip_jupyter//isort",
)

toolchain(
    name = "isort_toolchain",
    toolchain = ":py_isort_toolchain",
    toolchain_type = "@rules_venv//python/isort:toolchain_type",
)

# mypy 2.x imports `psutil` opportunistically to size its parser thread pool.
# The mypy aspect replaces dependency sources with caches but keeps their data
# files, so a target that depends on `psutil` (e.g. via `ipykernel`) leaves
# behind only its extension module. That imports as an empty namespace package
# and mypy crashes on `psutil.cpu_count`. Supplying `psutil` with the tool
# itself keeps its sources in the runner's closure, where they are never pruned.
py_library(
    name = "mypy",
    deps = [
        "@pip_jupyter//mypy",
        "@pip_jupyter//psutil",
    ],
)

py_mypy_toolchain(
    name = "py_mypy_toolchain",
    mypy = ":mypy",
)

toolchain(
    name = "mypy_toolchain",
    toolchain = ":py_mypy_toolchain",
    toolchain_type = "@rules_venv//python/mypy:toolchain_type",
)

py_pylint_toolchain(
    name = "py_pylint_toolchain",
    pylint = "@pip_jupyter//pylint",
)

toolchain(
    name = "pylint_toolchain",
    toolchain = ":py_pylint_toolchain",
    toolchain_type = "@rules_venv//python/pylint:toolchain_type",
)

py_pytest_toolchain(
    name = "py_pytest_toolchain",
    pytest = "@pip_jupyter//pytest_cov",
)

toolchain(
    name = "pytest_toolchain",
    toolchain = ":py_pytest_toolchain",
    toolchain_type = "@rules_venv//python/pytest:toolchain_type",
)

jupyter_toolchain(
    name = "py_jupyter_toolchain",
    bibtex = "@texlive//texk/bibtex-x:bibtex8",
    jupyter = "@pip_jupyter//jupyter",
    jupytext = "@pip_jupyter//jupytext",
    latex_data = [
        "@texlive//:texmf/bibtex",
        "@texlive//:texmf/fonts",
        "@texlive//:texmf/tex_inputs",
        "@texlive//:texmf/web2c_data",
    ],
    latex_engine = "@texlive//texk/web2c:pdftex",
    latex_format = "@texlive//:pdflatex_fmt",
    latex_texmf_cnf = "@texlive-texmf//:web2c/texmf.cnf",
    pandoc = "@pandoc",
    playwright_browsers_dir = "//playwright:current_browsers_dir",
    playwright_ld_library_dir = "//playwright:current_ld_library_dir",
)

toolchain(
    name = "jupyter_toolchain",
    toolchain = ":py_jupyter_toolchain",
    toolchain_type = "//jupyter:toolchain_type",
)
